# Telegram bot token from @BotFather. Required.
BOT_TOKEN=123456789:replace-with-your-token

# Only this Telegram user can use /allow, /deny, /allowed and /chatid.
# Get your numeric ID from @userinfobot. Required.
OWNER_ID=123456789

# Optional: where the owner/chat allowlist is persisted.
# Defaults to ./data. In production use a writable directory or volume.
# DATA_DIR=./data

# Post metadata providers. FxTwitter is primary, VxTwitter is a fallback.
# Set X_FALLBACK_API_BASE to an empty value to disable the fallback.
X_API_BASE=https://api.fxtwitter.com
X_FALLBACK_API_BASE=https://api.vxtwitter.com

# Telegram upload limits (bot API allows 10 MB photos and 50 MB videos).
MAX_PHOTO_MB=10
MAX_VIDEO_MB=45

# In-memory caches. Media is evicted when the byte budget is exceeded.
CACHE_TTL_MINUTES=30
MEDIA_CACHE_MB=64

# Networking
REQUEST_TIMEOUT_SECONDS=20

# Behaviour
MAX_LINKS_PER_MESSAGE=2
DROP_PENDING_UPDATES=false

# debug | info | warn | error
LOG_LEVEL=info
